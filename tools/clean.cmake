if(NOT DEFINED NEBULA_ROOT OR NOT DEFINED NEBULA_BUILD)
  message(FATAL_ERROR "Missing project/build roots")
endif()
file(REAL_PATH "${NEBULA_ROOT}" root)
get_filename_component(build "${NEBULA_BUILD}" ABSOLUTE BASE_DIR "${root}")
foreach(path IN ITEMS "${build}" "${root}/dist")
  if(EXISTS "${path}")
    file(REAL_PATH "${path}" resolved)
    string(FIND "${resolved}/" "${root}/" prefix)
    if(NOT prefix EQUAL 0 OR resolved STREQUAL root OR NOT EXISTS "${resolved}/.nebula-generated")
      message(FATAL_ERROR "Refusing to remove unmarked/outside directory: ${resolved}")
    endif()
    file(REMOVE_RECURSE "${resolved}")
    message(STATUS "Removed generated directory: ${resolved}")
  endif()
endforeach()
